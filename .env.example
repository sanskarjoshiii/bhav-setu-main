# Copy to .env and fill in.  .env is gitignored — never commit it.

# ─── database (required) ────────────────────────────────────────────────────
# Postgres from docker-compose.yml. Port 5433 avoids clashing with a local server.
DATABASE_URL=postgresql+psycopg://bhav:bhav@localhost:5433/bhav
# Redis from docker-compose.yml. Bot session state only (Phase 9).
REDIS_URL=redis://localhost:6380/0

# ─── data.gov.in / Agmarknet (required from Phase 2) ────────────────────────
# Your personal API key from data.gov.in → My Account → API Key.
DATA_GOV_IN_API_KEY=
# Resource UUID of the "Current Daily Price of Various Commodities" dataset.
AGMARKNET_RESOURCE_ID=

# ─── WhatsApp Cloud API (required from Phase 11, leave blank until then) ────
# Test phone number ID from the Meta app dashboard → WhatsApp → API Setup.
WHATSAPP_PHONE_NUMBER_ID=
# WhatsApp Business Account ID from the same page.
WHATSAPP_BUSINESS_ACCOUNT_ID=
# Temporary access token — expires every 24h, regenerate on demo morning.
WHATSAPP_ACCESS_TOKEN=
# App Secret from Meta app dashboard → App Settings → Basic.
WHATSAPP_APP_SECRET=
# Any random string you invent; you type the same one into Meta's webhook form.
WHATSAPP_VERIFY_TOKEN=

# ─── MongoDB — farmer history (Phase 15) ────────────────────────────────────
# From docker-compose.yml. Port 27018 avoids clashing with a local mongod.
MONGODB_URL=mongodb://bhav:bhav@localhost:27018/?authSource=admin
MONGODB_DB=bhav_history

# ─── SMTP magic-link sign-in (Phase 15) ─────────────────────────────────────
# Leave blank and the magic link is printed to the console instead of emailed,
# so a demo works with no mail account at all. Fill these in to send for real.
#
# Gmail: turn on 2-Step Verification, then create an App Password at
#   https://myaccount.google.com/apppasswords
# and paste the 16-character value into SMTP_PASSWORD (not your login password).
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
# The From: address farmers will see. Usually the same as SMTP_USER.
SMTP_FROM=
# Where the emailed link points — the website, not the API.
APP_BASE_URL=http://localhost:3000

# ─── frontend ───────────────────────────────────────────────────────────────
# Base URL the Next.js app calls the FastAPI backend on.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
